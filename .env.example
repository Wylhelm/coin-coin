# Offline browser audio modes need no credentials. Keep secrets in the ignored .env.
OPENAI_API_KEY=
ECHO=0
# Realtime model and voice are selected by S4; S3's provisional threshold is below.
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=
OPENCLAW_URL=http://127.0.0.1:18789
OPENCLAW_TOKEN=
OPENCLAW_AGENT=coin-coin
ROBOT_LINK=tcp://host.docker.internal:7810
FRAME_LINK=tcp://host.docker.internal:7811
QUACK_SINK=stream
WAKE_ENGINE=vosk
WAKE_THRESHOLD=0.9
FOLLOWUP_S=420
LANGS=fr,en
MAX_VX=0.25
MAX_VY=0.2
MAX_VYAW=1.0
MAX_MOVE_S=5
MOVE_HZ=20
LOG_AUDIO=false
LOG_RETENTION_DAYS=30
RELAY_TOKEN=
COINCOIN_PORT=8765
COMPOSE_PROJECT_NAME=coincoin
