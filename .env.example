# Offline browser audio modes need no credentials. Keep secrets in the ignored .env.
OPENAI_API_KEY=
ECHO=0
# S4 Realtime model; voice selected for audition, perceived age/gender unverified.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=verse
# auto follows the user's language. Set e.g. English or French for a preferred default.
RESPONSE_LANGUAGE=auto
OPENCLAW_URL=http://127.0.0.1:18789
OPENCLAW_TOKEN=
OPENCLAW_AGENT=coin-coin
ROBOT_LINK=tcp://host.docker.internal:7810
FRAME_LINK=tcp://host.docker.internal:7811
# One switch for delivery day: ROBOT_TARGET=robot + ROBOT_HOST=<duck IP from `duckctl ip`>
# (or ROBOT_TARGET=sim) replaces ROBOT_LINK with mediad's WebRTC path. Empty keeps ROBOT_LINK.
ROBOT_TARGET=
ROBOT_HOST=
ROBOT_SIGNALLING_PORT=8443
PERSON_MODE_TIMEOUT_S=120
QUACK_SINK=stream
WAKE_ENGINE=vosk
WAKE_THRESHOLD=0.9
FOLLOWUP_S=420
LANGS=fr,en
MAX_VX=0.25
MAX_VY=0.2
MAX_VYAW=1.0
MAX_MOVE_S=5
MOVE_HZ=20
LOG_AUDIO=false
LOG_RETENTION_DAYS=30
RELAY_TOKEN=
COINCOIN_PORT=8765
COMPOSE_PROJECT_NAME=coincoin
